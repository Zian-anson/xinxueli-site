---
import Base from '../layouts/Base.astro'
---
<Base title="页面不存在">
  <div class="mx-auto max-w-md space-y-6 py-16 text-center">
    <p class="font-serif-cn text-6xl text-amber-700/30">404</p>
    <div>
      <p class="text-xl font-semibold">这里没有内容</p>
      <p class="mt-2 text-sm text-stone-500">地址可能拼错了，或者这一页还没写。</p>
    </div>
    <div class="flex flex-wrap justify-center gap-3">
      <a href="/" class="btn-primary">回首页</a>
      <a href="/course.html" class="btn-ghost">看课程</a>
    </div>
  </div>
</Base>
