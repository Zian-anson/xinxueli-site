---
import { getCollection } from 'astro:content'
import Base from '../layouts/Base.astro'

const [course, gates, cases, dict] = await Promise.all([
  getCollection('course'),
  getCollection('gates'),
  getCollection('cases'),
  getCollection('dict'),
])

const chapters = course.sort((a, b) => a.data.part - b.data.part || a.data.chapter - b.data.chapter)
const part1 = chapters.filter((c) => c.data.part === 1)
const part2 = chapters.filter((c) => c.data.part === 2)
const startPath = ['p1-ch0', 'p1-ch1', 'p1-ch2'].map((id) => chapters.find((c) => c.data.id === id)).filter(Boolean)

const stats = [
  { value: `${chapters.length}`, label: '章课程' },
  { value: `${gates.length}`, label: '条真实关卡' },
  { value: `${cases.length}`, label: '篇案例' },
  { value: `${dict.length}`, label: '个白话词条' },
]

const differences = [
  {
    no: '01',
    title: '不教写代码，教工程判断',
    body: 'AI 写代码，人做验收与判断。课程教写代码之外的全部编程知识：运行环境、网络与 Web、数据、工程与协作、架构与产品、AI/Agent 工程。',
  },
  {
    no: '02',
    title: '用一个真实项目做标本',
    body: 'DeepSeek Harness 是解剖标本，不是课程目的。拆它是为了看懂真实系统的结构、插件、配置、改动影响和回退方式。',
  },
  {
    no: '03',
    title: '学完手里有东西',
    body: '一个自己改造的个人 Agent，一个真实上线、别人能用的产品，一次真实到账的收款。不是证书，是能自己走路的东西。',
  },
]

const mapBlocks = ['界面基础（前端）', '运行环境', '网络与 Web', '数据', '工程与协作', '架构与产品', 'AI/Agent 工程']

const features = [
  {
    title: '划词标「不懂」',
    body: '读到卡住的地方，选中那句话，写下问题。标注存在你自己的浏览器里，刷新不丢，不上传。',
  },
  {
    title: 'AI 按协议回填',
    body: '在 Qoder 里打开这一页，AI 通过页面自述和导师协议看到你的标注，回答落在对话里，精华回填到标注旁。',
  },
  {
    title: '学习档案可带走',
    body: '阅读进度、标注、回填合成一份 markdown。交给你的 AI 导师，它就知道你学到哪、卡在哪。',
  },
]
---
<Base title="零代码，把产品做到上线收钱" wide>
  <div class="space-y-20 md:space-y-28">
    <section class="grid items-center gap-10 pt-4 lg:grid-cols-[1.12fr_0.88fr] lg:gap-14">
      <div>
        <p class="eyebrow">零代码 · 编程通识 · 和 AI 一起做产品</p>
        <h1 class="mt-5 text-3xl font-bold leading-[1.3] md:text-[2.75rem] md:leading-[1.25]">
          不写代码，也不读源码。<br class="hidden sm:block" />
          <span class="whitespace-nowrap">看得懂系统，</span><span class="whitespace-nowrap text-brand">验收得住结果。</span>
        </h1>
        <p class="mt-6 max-w-xl text-base leading-8 text-stone-600 md:text-lg">
          AI 写代码，人做判断。新学力教写代码之外的全部编程知识：程序怎么跑、数据怎么流、问题出在哪层、改动会影响什么、怎么验收、怎么回退。学完你手里有一个自己改造的 Agent、一个真实上线的产品，和一次真实收款。
        </p>
        <div class="mt-8 flex flex-wrap gap-3">
          <a href="/course/p1-ch0.html" class="btn-primary">从第 0 章开始 <span aria-hidden="true">→</span></a>
          <a href="/map.html" class="btn-ghost">看基础大类</a>
        </div>
        <dl class="mt-10 grid max-w-lg grid-cols-4 gap-4 border-t border-line pt-6">
          {stats.map((s) => (
            <div>
              <dt class="text-2xl font-bold text-stone-800"><span class="font-serif-cn">{s.value}</span></dt>
              <dd class="mt-1 text-xs text-stone-500">{s.label}</dd>
            </div>
          ))}
        </dl>
      </div>

      <div class="relative">
        <div class="absolute -inset-4 -z-10 rounded-[2rem] bg-gradient-to-br from-amber-100/70 via-transparent to-stone-100/40 blur-2xl"></div>
        <div class="card overflow-hidden shadow-[0_24px_60px_-36px_rgba(120,83,9,0.55)]">
          <div class="flex items-center justify-between border-b border-line bg-brand-soft/60 px-5 py-3">
            <span class="text-xs text-stone-500">第 1 章 · 看懂产品骨架</span>
            <span class="tag">活页面</span>
          </div>
          <div class="px-5 py-5" data-demo>
            <p class="text-[15px] leading-8 text-stone-700">
              任何一件产品都由四部分组成：
              <button type="button" data-demo-word aria-expanded="false" class="cursor-pointer rounded-sm font-medium text-stone-900 underline decoration-amber-400 decoration-2 underline-offset-4 transition hover:bg-amber-100">前端</button>、后端、数据和插件。出问题时，先认出是哪一层，再动手。
            </p>
            <div data-demo-anno hidden class="mt-4 rounded-lg border border-amber-200 bg-amber-50/80 p-4">
              <p class="text-xs text-amber-800/70">不懂</p>
              <p class="mt-1 text-sm font-medium text-stone-800">「前端」到底指什么？</p>
              <div class="mt-3 rounded-md bg-white/80 p-3">
                <p class="text-xs text-stone-500">导师回填</p>
                <p class="mt-1 text-sm leading-7 text-stone-700">就是你看到、能点的这个页面：标题、按钮、输入框，都是前端。后端在幕后干活，你直接看不见。</p>
              </div>
            </div>
            <p class="mt-4 text-xs text-stone-400" data-demo-hint>点带下划线的词，试试标注</p>
          </div>
          <div class="border-t border-line bg-stone-50/60 px-5 py-3 text-xs text-stone-500">
            在 Qoder 里打开，AI 能读到这条标注并回填。
          </div>
        </div>
      </div>
    </section>

    <section>
      <div class="flex flex-wrap items-end justify-between gap-4">
        <div>
          <p class="text-sm font-medium text-brand">从这里开始</p>
          <h2 class="mt-2 text-2xl font-bold md:text-3xl">三步，先让工具跑起来</h2>
        </div>
        <a href="/course.html" class="text-sm text-stone-500 hover:text-brand">全部课程 →</a>
      </div>
      <div class="mt-8 grid gap-4 md:grid-cols-3">
        {startPath.map((c, i) => (
          <a href={`/course/${c!.data.id}.html`} class="card card-hover group block p-6">
            <div class="flex items-center justify-between">
              <span class="font-serif-cn text-3xl text-amber-700/50">0{i + 1}</span>
              <span class="tag">{c!.data.pace}</span>
            </div>
            <h3 class="mt-4 text-lg font-semibold group-hover:text-brand">第 {c!.data.chapter} 章 · {c!.data.title}</h3>
            <p class="mt-2 text-sm leading-6 text-stone-500">{c!.data.goal}</p>
          </a>
        ))}
      </div>
    </section>

    <section class="rounded-2xl border border-line bg-surface p-6 md:p-10">
      <div class="grid gap-8 lg:grid-cols-[0.95fr_1.05fr] lg:items-center">
        <div>
          <p class="text-sm font-medium text-brand">基础大类</p>
          <h2 class="mt-2 text-2xl font-bold md:text-3xl">全部编程知识，一张图收口</h2>
          <p class="mt-3 text-sm leading-7 text-stone-600">
            主轴是验收与判断：看行为、读证据、认层、判影响、判可逆、验收。七块底座是界面基础（前端）、运行环境、网络与 Web、数据、工程与协作、架构与产品、AI/Agent 工程。读源码是可选项，不是入门要求。
          </p>
          <a href="/map.html" class="btn-primary mt-5">打开基础大类 <span aria-hidden="true">→</span></a>
        </div>
        <div class="grid grid-cols-2 gap-2 sm:grid-cols-3">
          {mapBlocks.map((b, i) => (
            <a href="/map.html" class="rounded-lg border border-line bg-stone-50/70 p-3 text-xs text-stone-600 transition hover:border-amber-300 hover:text-brand">
              <span class="font-serif-cn text-amber-700/60">0{i + 1}</span>
              <span class="mt-1 block font-medium">{b}</span>
            </a>
          ))}
        </div>
      </div>
    </section>

    <section class="grid gap-8 rounded-2xl border border-line bg-surface p-6 md:p-10 lg:grid-cols-[1fr_1fr] lg:items-center">
      <div>
        <p class="text-sm font-medium text-brand">基础大类 · 界面基础（前端）</p>
        <h2 class="mt-2 text-2xl font-bold md:text-3xl">看得懂前端，才说得出问题</h2>
        <p class="mt-3 text-sm leading-7 text-stone-600">
          截图只能告诉 AI 长什么样，说不出哪里不对、想要什么样。前端基础页给你一套最小词汇：元素、容器、布局、盒子、响应式、状态、症状词；问题描述器再帮你把看到的现象说成 AI 能改的话。
        </p>
        <div class="mt-5 flex flex-wrap gap-3">
          <a href="/frontend.html" class="btn-primary">看前端基础</a>
          <a href="/describe.html" class="btn-ghost">用问题描述器</a>
        </div>
      </div>
      <div class="grid gap-3">
        <div class="rounded-lg border border-red-200 bg-red-50/40 p-4">
          <p class="text-xs text-red-700">坏说法</p>
          <p class="mt-1 text-sm leading-7 text-stone-700">“这个页面有点乱，帮我调一下。” + 截图</p>
        </div>
        <div class="rounded-lg border border-emerald-200 bg-emerald-50/40 p-4">
          <p class="text-xs text-emerald-700">好说法</p>
          <p class="mt-1 text-sm leading-7 text-stone-700">“在 390px 宽的手机上，首页标题下面的「开始学习」按钮被挤到第二行，宽度超出容器约 20px，出现横向滚动。期望标题、说明、按钮在第一屏内，按钮不超出容器。”</p>
        </div>
      </div>
    </section>

    <section>
      <div class="flex flex-wrap items-end justify-between gap-4">
        <div>
          <p class="text-sm font-medium text-brand">课程全景</p>
          <h2 class="mt-2 text-2xl font-bold md:text-3xl">两大部分，从装工具到收到第一笔钱</h2>
        </div>
      </div>
      <div class="mt-8 grid gap-5 lg:grid-cols-2">
        {[{ part: 1, title: '第一部分 · 开发', sub: '从用 DeepSeek Harness 到自造 Harness', list: part1 }, { part: 2, title: '第二部分 · 商业闭环', sub: '做出产品，收到钱', list: part2 }].map((p) => (
          <div class="card p-6">
            <div class="flex items-start justify-between gap-4">
              <div>
                <h3 class="text-xl font-semibold">{p.title}</h3>
                <p class="mt-1 text-sm text-stone-500">{p.sub}</p>
              </div>
              <span class="tag">{p.list.length} 章</span>
            </div>
            <ul class="mt-5 space-y-2 border-t border-line pt-4 text-sm">
              {p.list.slice(0, 4).map((c) => (
                <li class="flex items-baseline justify-between gap-3">
                  <a href={`/course/${c.data.id}.html`} class="text-stone-700 hover:text-brand">第 {c.data.chapter} 章 · {c.data.title}</a>
                  <span class="shrink-0 text-xs text-stone-400">{c.data.pace}</span>
                </li>
              ))}
              {p.list.length > 4 && (
                <li class="pt-1 text-xs text-stone-400">还有 {p.list.length - 4} 章，进课程看全部</li>
              )}
            </ul>
            <a href="/course.html" class="mt-5 inline-flex text-sm font-medium text-brand hover:text-brand-strong">进入课程 →</a>
          </div>
        ))}
      </div>
    </section>

    <section class="rounded-2xl border border-line bg-surface p-6 md:p-10">
      <p class="text-sm font-medium text-brand">为什么不是又一门课</p>
      <h2 class="mt-2 text-2xl font-bold md:text-3xl">不教写代码，教验收与判断</h2>
      <div class="mt-8 grid gap-6 md:grid-cols-3">
        {differences.map((d) => (
          <div class="border-t border-line pt-5">
            <span class="font-serif-cn text-sm text-amber-700/70">{d.no}</span>
            <h3 class="mt-2 text-lg font-semibold">{d.title}</h3>
            <p class="mt-2 text-sm leading-7 text-stone-500">{d.body}</p>
          </div>
        ))}
      </div>
    </section>

    <section class="grid gap-8 lg:grid-cols-[0.9fr_1.1fr] lg:items-center">
      <div>
        <p class="text-sm font-medium text-brand">它是一件活的产品</p>
        <h2 class="mt-2 text-2xl font-bold md:text-3xl">这个网站本身，就是学员和 AI 共用的工作台</h2>
        <p class="mt-4 text-sm leading-7 text-stone-600">
          它不只是一个看文章的地方。你可以边读边把不懂的地方标出来，Qoder 里的 AI 看得到；回答落在对话里，反馈回填到网页上。阅读记录和标注还能导出成学习档案，交给你的 AI 导师。
        </p>
        <div class="mt-6 flex flex-wrap gap-3">
          <a href="/course/p1-ch1.html" class="btn-primary">打开一章试试</a>
          <a href="/me.html" class="btn-ghost">看学习档案</a>
        </div>
        <p class="mt-4 text-xs text-stone-400">标注只存在你的浏览器，不上传服务器。<a href="/tutor.json" class="underline hover:text-brand">导师协议</a></p>
      </div>
      <div class="space-y-3">
        {features.map((f, i) => (
          <div class="card flex gap-4 p-5">
            <span class="flex h-9 w-9 shrink-0 items-center justify-center rounded-full bg-brand-soft font-serif-cn text-sm text-brand">{i + 1}</span>
            <div>
              <h3 class="font-semibold">{f.title}</h3>
              <p class="mt-1 text-sm leading-7 text-stone-500">{f.body}</p>
            </div>
          </div>
        ))}
      </div>
    </section>

    <section class="grid gap-5 md:grid-cols-2">
      <div class="card p-6">
        <h2 class="text-lg font-semibold">适合谁</h2>
        <ul class="mt-3 space-y-2 text-sm leading-7 text-stone-600">
          <li>· 完全不会编程，也不打算读源码，但想做出真实产品的人</li>
          <li>· 愿意用真实结果验收 AI 的人</li>
          <li>· 想把 AI 用成工程队，而不是只会聊天的人</li>
        </ul>
      </div>
      <div class="card p-6">
        <h2 class="text-lg font-semibold">不适合谁</h2>
        <ul class="mt-3 space-y-2 text-sm leading-7 text-stone-600">
          <li>· 想速成程序员、背语法的人</li>
          <li>· 只想看不想动手的人</li>
          <li>· 期待一份证书就能找工作的人</li>
        </ul>
      </div>
    </section>

    <section class="rounded-2xl bg-stone-900 px-6 py-10 text-center text-stone-100 md:px-10 md:py-14">
      <h2 class="text-2xl font-bold md:text-3xl">今天就做一件事：把工具跑起来</h2>
      <p class="mx-auto mt-3 max-w-xl text-sm leading-7 text-stone-300">第 0 章只做两件事：装好 Qoder，装好 DSH，完成一次对话。剩下的，一章一章来。</p>
      <div class="mt-7 flex flex-wrap justify-center gap-3">
        <a href="/course/p1-ch0.html" class="inline-flex items-center justify-center rounded-lg bg-amber-500 px-5 py-2.5 text-sm font-medium text-stone-950 transition hover:bg-amber-400">从第 0 章开始 <span aria-hidden="true">→</span></a>
        <a href="/course.html" class="inline-flex items-center justify-center rounded-lg border border-stone-600 px-5 py-2.5 text-sm font-medium text-stone-100 transition hover:border-stone-400">先看目录</a>
      </div>
    </section>
  </div>

  <script>
    const demoWord = document.querySelector<HTMLButtonElement>('[data-demo-word]')
    const demoAnno = document.querySelector<HTMLElement>('[data-demo-anno]')
    const demoHint = document.querySelector<HTMLElement>('[data-demo-hint]')
    if (demoWord && demoAnno) {
      demoWord.addEventListener('click', () => {
        const open = demoAnno.hidden
        demoAnno.hidden = !open
        demoWord.setAttribute('aria-expanded', String(open))
        if (demoHint) demoHint.textContent = open ? '已标注。在 Qoder 里，AI 会看到这条' : '点带下划线的词，试试标注'
      })
    }
  </script>
</Base>
