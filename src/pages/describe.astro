---
import Base from '../layouts/Base.astro'
---
<Base title="问题描述器" description="把看到的前端问题，按环境、元素、位置、现象、期望说成 AI 能改的话。">
  <div class="mx-auto max-w-3xl space-y-8">
    <nav class="text-xs text-stone-400">
      <a href="/map.html" class="hover:text-brand">基础大类</a>
      <span class="mx-2">/</span>
      <span>描述层</span>
    </nav>
    <header>
      <p class="eyebrow">基础大类 · 描述层</p>
      <h1 class="mt-5 text-3xl font-bold md:text-4xl">把看到的问题，说成 AI 能改的话。</h1>
      <p class="mt-4 text-sm leading-8 text-stone-600">
        选几下，填一句期望，生成一段可直接复制给 AI 的描述。它不替你判断，只帮你把“哪里不对”说全：环境、元素、位置、现象、期望、证据。
      </p>
    </header>

    <form id="describe-form" class="card space-y-5 p-6">
      <div class="grid gap-4 sm:grid-cols-2">
        <label class="block text-sm">
          <span class="font-medium text-stone-700">环境</span>
          <select id="env" class="mt-1 w-full rounded-lg border border-line bg-white px-3 py-2 text-sm">
            <option>手机 390px</option>
            <option>手机 375px</option>
            <option>平板 768px</option>
            <option>电脑 1440px</option>
            <option>不确定</option>
          </select>
        </label>
        <label class="block text-sm">
          <span class="font-medium text-stone-700">你怀疑的层</span>
          <select id="layer" class="mt-1 w-full rounded-lg border border-line bg-white px-3 py-2 text-sm">
            <option>界面</option>
            <option>数据</option>
            <option>后端</option>
            <option>部署</option>
            <option>不确定</option>
          </select>
        </label>
        <label class="block text-sm">
          <span class="font-medium text-stone-700">元素</span>
          <select id="element" class="mt-1 w-full rounded-lg border border-line bg-white px-3 py-2 text-sm">
            <option>按钮</option>
            <option>文字</option>
            <option>图片</option>
            <option>表单</option>
            <option>导航</option>
            <option>卡片</option>
            <option>弹窗</option>
            <option>其他</option>
          </select>
        </label>
        <label class="block text-sm">
          <span class="font-medium text-stone-700">位置</span>
          <select id="position" class="mt-1 w-full rounded-lg border border-line bg-white px-3 py-2 text-sm">
            <option>页面顶部</option>
            <option>页面中间</option>
            <option>页面底部</option>
            <option>某个区块内</option>
            <option>其他</option>
          </select>
        </label>
        <label class="block text-sm sm:col-span-2">
          <span class="font-medium text-stone-700">现象</span>
          <select id="symptom" class="mt-1 w-full rounded-lg border border-line bg-white px-3 py-2 text-sm">
            <option>溢出（内容超出容器 / 横向滚动）</option>
            <option>错位（没对齐 / 跑到第二行）</option>
            <option>重叠（被盖住 / 叠在一起）</option>
            <option>遮挡（点不到 / 被弹窗挡住）</option>
            <option>点不到（按钮在但没反应）</option>
            <option>不显示（元素在但看不见）</option>
            <option>跳动（加载后位置变了）</option>
            <option>换行（文字/按钮被挤下去）</option>
            <option>拉伸（图片变形）</option>
            <option>滚动（页面能横向滑）</option>
            <option>层级（谁在上面看不清）</option>
            <option>颜色/对比度不对</option>
            <option>其他</option>
          </select>
        </label>
        <label class="block text-sm sm:col-span-2">
          <span class="font-medium text-stone-700">期望</span>
          <textarea id="expected" rows="2" placeholder="正确的结果长什么样？比如：标题、说明、按钮在第一屏内，按钮不超出容器。" class="mt-1 w-full resize-y rounded-lg border border-line bg-white px-3 py-2 text-sm"></textarea>
        </label>
        <label class="block text-sm sm:col-span-2">
          <span class="font-medium text-stone-700">补充</span>
          <textarea id="extra" rows="2" placeholder="可选：多宽、偏了多少、什么时候开始出现、刚改了什么。" class="mt-1 w-full resize-y rounded-lg border border-line bg-white px-3 py-2 text-sm"></textarea>
        </label>
      </div>

      <fieldset>
        <legend class="text-sm font-medium text-stone-700">证据</legend>
        <div class="mt-2 flex flex-wrap gap-3 text-sm text-stone-600">
          {['截图', '报错全文', 'Console 信息', '元素检查结果'].map((label) => (
            <label class="inline-flex items-center gap-1.5">
              <input type="checkbox" data-evidence value={label} class="h-4 w-4 rounded border-line" />
              {label}
            </label>
          ))}
        </div>
      </fieldset>

      <div class="flex flex-wrap gap-2">
        <button type="button" id="generate" class="btn-primary">生成描述</button>
        <button type="button" id="example" class="btn-ghost">填入示例</button>
        <button type="button" id="copy" class="btn-ghost">复制</button>
        <span id="copy-status" class="self-center text-xs text-stone-400"></span>
      </div>
    </form>

    <section>
      <div class="flex items-center justify-between gap-3">
        <h2 class="text-lg font-semibold">生成结果</h2>
        <span class="text-xs text-stone-400">复制到 Qoder，让 AI 先认层再改</span>
      </div>
      <pre id="output" class="mt-3 min-h-48 whitespace-pre-wrap rounded-xl border border-line bg-white p-5 text-sm leading-7 text-stone-700">选好上面的信息，点「生成描述」。</pre>
    </section>

    <section class="rounded-xl border border-amber-200 bg-brand-soft p-5 text-sm leading-7 text-stone-700">
      <p class="font-medium">为什么这样描述有效</p>
      <p class="mt-1">AI 不怕信息多，怕信息缺。你说“页面乱了”，它只能大范围重做；你说“390px 宽、按钮、被挤到第二行、宽度超出容器、期望不超出”，它只需要动布局和宽度。描述越准，改动越小，验收越快。</p>
      <p class="mt-2">想补词汇，去 <a href="/frontend.html" class="text-brand hover:underline">前端基础</a>；想练过坎，去 <a href="/gates.html" class="text-brand hover:underline">关卡库</a>。</p>
    </section>
  </div>

  <script>
    const $ = (id: string) => document.getElementById(id) as HTMLInputElement | HTMLSelectElement | HTMLTextAreaElement | null
    const output = document.getElementById('output')
    const copyStatus = document.getElementById('copy-status')

    const build = () => {
      const env = $('env')?.value ?? ''
      const layer = $('layer')?.value ?? ''
      const element = $('element')?.value ?? ''
      const position = $('position')?.value ?? ''
      const symptom = $('symptom')?.value ?? ''
      const expected = $('expected')?.value.trim() ?? ''
      const extra = $('extra')?.value.trim() ?? ''
      const evidence = [...document.querySelectorAll<HTMLInputElement>('[data-evidence]:checked')].map((el) => el.value)
      return [
        `环境：${env}`,
        `怀疑的层：${layer}`,
        `元素：${element}`,
        `位置：${position}`,
        `现象：${symptom}`,
        `期望：${expected || '（请补充）'}`,
        `证据：${evidence.length ? evidence.join('、') : '暂无'}`,
        extra ? `补充：${extra}` : '',
        '',
        '请先判断这是哪一层的问题，再给最小改动方案；改完告诉我怎么验收。',
      ].filter(Boolean).join('\n')
    }

    document.getElementById('generate')?.addEventListener('click', () => {
      if (output) output.textContent = build()
    })

    document.getElementById('example')?.addEventListener('click', () => {
      const set = (id: string, value: string) => {
        const el = $(id)
        if (el) el.value = value
      }
      set('env', '手机 390px')
      set('layer', '界面')
      set('element', '按钮')
      set('position', '页面顶部')
      set('symptom', '换行（文字/按钮被挤下去）')
      set('expected', '标题、说明、按钮在第一屏内，按钮不超出容器。')
      set('extra', '首页标题下面的「开始学习」按钮宽度超出容器约 20px，出现横向滚动。')
      const checks = document.querySelectorAll<HTMLInputElement>('[data-evidence]')
      checks.forEach((c) => (c.checked = c.value === '截图'))
      if (output) output.textContent = build()
    })

    document.getElementById('copy')?.addEventListener('click', async () => {
      const text = output?.textContent?.trim() ?? ''
      if (!text) return
      try {
        await navigator.clipboard.writeText(text)
        if (copyStatus) copyStatus.textContent = '已复制'
      } catch {
        if (copyStatus) copyStatus.textContent = '复制失败，请手动选择'
      }
      window.setTimeout(() => {
        if (copyStatus) copyStatus.textContent = ''
      }, 2500)
    })
  </script>
</Base>
