---
import Base from '../layouts/Base.astro'

const m = {
  title: '带着项目学',
  what: '带自己的真实项目进来，按项目阶段配学习内容，在做中学。',
  when: '模块二之后。',
  now: '先把两大部分学完，手里有货再带项目来。',
}
---
<Base title={m.title}>
  <div class="max-w-3xl space-y-8">
    <header>
      <p class="text-sm font-medium text-brand">模块三</p>
      <h1 class="mt-2 text-3xl font-bold">{m.title}<span class="ml-3 align-middle text-xs font-normal text-stone-500">建设中</span></h1>
      <p class="mt-4 text-sm leading-7 text-stone-600">{m.what}</p>
    </header>
    <div class="grid gap-4 sm:grid-cols-3">
      <div class="card p-5">
        <p class="text-xs text-stone-400">是什么</p>
        <p class="mt-2 text-sm leading-7 text-stone-600">{m.what}</p>
      </div>
      <div class="card p-5">
        <p class="text-xs text-stone-400">什么时候来</p>
        <p class="mt-2 text-sm leading-7 text-stone-600">{m.when}</p>
      </div>
      <div class="card p-5">
        <p class="text-xs text-stone-400">现在能做什么</p>
        <p class="mt-2 text-sm leading-7 text-stone-600">{m.now}</p>
      </div>
    </div>
    <div class="rounded-xl border border-amber-200 bg-brand-soft p-5 text-sm leading-7 text-stone-700">
      <p class="font-medium">不急着来</p>
      <p class="mt-1">没有自己的真实项目时，硬带一个假项目进来，学的还是课程内容。先把第 10 章的毕业项目做完，那里已经逼你选一个自己的题。</p>
    </div>
    <div class="flex flex-wrap gap-3">
      <a href="/course.html" class="btn-primary">去学课程</a>
      <a href="/course/p2-ch10.html" class="btn-ghost">看毕业项目</a>
    </div>
  </div>
</Base>
