---
import { getCollection } from 'astro:content'
import Base from '../../layouts/Base.astro'
import { splitUnits } from '../../lib/sections'
import { marked } from 'marked'

export async function getStaticPaths() {
  const all = await getCollection('gates')
  return all.map((e) => ({ params: { id: e.data.id }, props: { e } }))
}

const { e } = Astro.props
const units = splitUnits(e.data.id, e.body ?? '')
---
<Base title={e.data.title} description={`${e.data.category} · ${e.data.layer} · ${e.data.title}`} pageType="gate" pageId={e.data.id} units={units.map((u) => ({ id: u.id, title: u.title }))}>
  <article class="max-w-3xl">
    <nav class="text-xs text-stone-400">
      <a href="/gates.html" class="hover:text-brand">关卡库</a>
      <span class="mx-2">/</span>
      <span>{e.data.category}</span>
    </nav>
    <header class="mt-3 space-y-3 border-b border-line pb-6">
      <div class="flex flex-wrap items-center gap-2 text-xs text-stone-500">
        <span class="tag">{e.data.category}</span>
        <span class="tag">{e.data.layer}</span>
        <span class="tag">严重度 {e.data.severity}</span>
        <span>更新 {e.data.updated}</span>
      </div>
      <h1 class="text-3xl font-bold leading-tight">{e.data.title}</h1>
      <p class="text-sm text-stone-500">一条真实卡点的完整档案。可以划词标注，AI 会按导师协议回填。</p>
    </header>
    {units.map((u) => (
      <section id={u.id} data-unit data-unit-title={u.title} class="scroll-mt-24">
        <h2 class="mb-3 mt-10 text-2xl font-semibold">{u.title}</h2>
        <div class="prose prose-stone max-w-none" set:html={marked.parse(u.md) as string} />
      </section>
    ))}
    <div class="mt-12 rounded-xl border border-amber-200 bg-brand-soft p-5 text-sm leading-7 text-stone-700">
      <p class="font-medium">这类坎的通用处理法</p>
      <p class="mt-1">第 3 章把六类坎拆开讲，每类给通用处理法，并映射回产品的层。<a href="/course/p1-ch3.html" class="text-brand hover:underline">去读第 3 章 →</a></p>
    </div>
    <nav class="mt-8 border-t border-line pt-4 text-sm">
      <a href="/gates.html" class="text-stone-500 hover:text-brand">← 返回关卡库</a>
    </nav>
  </article>
</Base>
